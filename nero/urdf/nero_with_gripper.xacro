<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agx_arm_urdf)/nero/urdf/nero_arm.xacro"/>
  <xacro:include filename="$(find agx_arm_urdf)/gripper/urdf/agx_gripper.xacro"/>

  <xacro:macro name="nero_with_gripper_flange" params="prefix">
    <xacro:nero_arm prefix="${prefix}"/>
    <link name="${prefix}gripper_flange">
      <inertial>
        <origin xyz="0.000253201 -0.000322696 -0.010082901" rpy="0 0 0"/>
        <mass value="0.04771096"/>
        <inertia ixx="36.14107e-06" ixy="0" ixz="0" iyy="17.824164e-06" iyz="0" izz="26.95944e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/nero/meshes/dae/gripper_flange.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/nero/meshes/gripper_flange.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_flange_joint" type="fixed">
      <origin xyz="0.031 0 -0.0235" rpy="-1.5708 0 -1.5708"/>
      <parent link="${prefix}link7"/>
      <child link="${prefix}gripper_flange"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="nero_with_gripper" params="prefix">
    <xacro:nero_with_gripper_flange prefix="${prefix}"/>
    <xacro:agx_gripper prefix="${prefix}" model="nero" parent_link="gripper_flange"
      base_xyz="0 0 0.006" base_rpy="0 0 0"
      finger1_rpy="1.5707963 0 3.1415926" finger2_rpy="1.5707963 0 0"/>
  </xacro:macro>
</robot>
