<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="joint_limits_file" default="$(find agx_arm_urdf)/piper/config/joint_position_limits_original.yaml"/>
  <xacro:include filename="$(find agx_arm_urdf)/piper/urdf/piper_with_gripper.xacro"/>
  <xacro:piper_with_gripper prefix="$(arg prefix)" joint_limits_file="$(arg joint_limits_file)"/>
  <link name="world"/>
  <joint name="world_to_$(arg prefix)base_link" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
