<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agx_arm_urdf)/piper/urdf/piper_arm.xacro"/>
  <xacro:include filename="$(find agx_arm_urdf)/gripper/urdf/agx_gripper.xacro"/>

  <xacro:macro name="piper_with_gripper" params="prefix joint_limits_file:='$(find agx_arm_urdf)/piper/config/joint_position_limits.yaml'">
    <xacro:piper_arm prefix="${prefix}" joint_limits_file="${joint_limits_file}"/>
    <xacro:piper_gripper_flange prefix="${prefix}" model="piper"/>
    <xacro:agx_gripper prefix="${prefix}" model="piper" parent_link="flange_link"
      base_xyz="0 0 0.0045" base_rpy="0 0 0"
      finger1_rpy="1.5707963 0 0" finger2_rpy="1.5707963 0 -3.1415926"/>
  </xacro:macro>
</robot>
