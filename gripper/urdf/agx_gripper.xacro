<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="piper_gripper_flange" params="prefix model">
    <link name="${prefix}flange_link">
      <inertial>
        <origin xyz="1.151691e-03 0.782428e-03 4.798051e-03" rpy="0 0 0"/>
        <mass value="0.04"/>
        <inertia ixx="9.935389e-06" ixy="0.0" ixz="0.0" iyy="10.508003e-06" iyz="0.0" izz="19.652873e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/dae/flange.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/flange.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}flange_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}flange_link"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="agx_gripper" params="prefix model parent_link base_xyz base_rpy finger1_rpy finger2_rpy">
    <link name="${prefix}gripper_base">
      <inertial>
        <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876" rpy="0 0 0"/>
        <mass value="0.45"/>
        <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/dae/gripper_base.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/gripper_base.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <origin xyz="${base_xyz}" rpy="${base_rpy}"/>
      <parent link="${prefix}${parent_link}"/>
      <child link="${prefix}gripper_base"/>
    </joint>

    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <origin xyz="0 0 0.138" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_tcp"/>
    </joint>

    <link name="${prefix}gripper_link"/>
    <joint name="${prefix}gripper" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.1" effort="10" velocity="3"/>
    </joint>

    <link name="${prefix}gripper_link1">
      <inertial>
        <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/dae/gripper_link1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/gripper_link1.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_joint1" type="prismatic">
      <origin xyz="0 0 0.138" rpy="${finger1_rpy}"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.05" effort="10" velocity="3"/>
      <mimic joint="${prefix}gripper" multiplier="0.5" offset="0.0"/>
    </joint>

    <link name="${prefix}gripper_link2">
      <inertial>
        <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/dae/gripper_link2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_urdf/${model}/meshes/gripper_link2.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}gripper_joint2" type="prismatic">
      <origin xyz="0 0 0.138" rpy="${finger2_rpy}"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_link2"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.05" upper="0" effort="10" velocity="3"/>
      <mimic joint="${prefix}gripper" multiplier="-0.5" offset="0.0"/>
    </joint>
  </xacro:macro>
</robot>
