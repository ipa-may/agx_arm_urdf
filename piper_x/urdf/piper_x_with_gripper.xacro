<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agx_arm_urdf)/piper_x/urdf/piper_x_arm.xacro"/>
  <xacro:include filename="$(find agx_arm_urdf)/gripper/urdf/agx_gripper.xacro"/>

  <xacro:macro name="piper_x_with_gripper" params="prefix">
    <xacro:piper_x_arm prefix="${prefix}"/>
    <xacro:piper_gripper_flange prefix="${prefix}" model="piper_x"/>
    <xacro:agx_gripper prefix="${prefix}" model="piper_x" parent_link="flange_link"
      base_xyz="0 0 0.0045" base_rpy="0 0 1.5707963"
      finger1_rpy="1.5707963 0 0" finger2_rpy="1.5707963 0 -3.1415926"/>
  </xacro:macro>
</robot>
