<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_x">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find agx_arm_urdf)/piper_x/urdf/piper_x_with_gripper.xacro"/>
  <xacro:piper_x_with_gripper prefix="$(arg prefix)"/>
  <link name="world"/>
  <joint name="world_to_$(arg prefix)base_link" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
